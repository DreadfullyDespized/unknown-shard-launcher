<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux CI/dev boxes; the app itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UnknownShardLauncher</AssemblyName>
    <RootNamespace>UnknownShardLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Unknown Shard Launcher</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnknownShard.Launcher.Core\UnknownShard.Launcher.Core.csproj" />
  </ItemGroup>
</Project>

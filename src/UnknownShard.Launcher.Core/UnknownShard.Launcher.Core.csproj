    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnknownShard.Patching\UnknownShard.Patching.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Trusted manifest-signing public key(s), compiled into the launcher. -->

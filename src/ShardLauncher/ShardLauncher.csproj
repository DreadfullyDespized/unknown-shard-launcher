<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux CI/dev boxes; the app itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe name and product name can be set by the (gitignored) build config, see launcher.build.example.props. -->
    <AssemblyName Condition="'$(LauncherAssemblyName)' != ''">$(LauncherAssemblyName)</AssemblyName>
    <AssemblyName Condition="'$(LauncherAssemblyName)' == ''">ShardLauncher</AssemblyName>
    <RootNamespace>ShardLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Product Condition="'$(LauncherDisplayName)' != ''">$(LauncherDisplayName) Launcher</Product>
    <Product Condition="'$(LauncherDisplayName)' == ''">Shard Launcher</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShardLauncher.Core\ShardLauncher.Core.csproj" />
  </ItemGroup>
</Project>
